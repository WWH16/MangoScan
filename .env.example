# Copy this file to .env and fill in the values. Never commit .env.

# Supabase: Dashboard > Project Settings > API Keys (and Data API for the URL)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MANGOSCAN_SECRET_KEY=replace-with-a-long-random-string
